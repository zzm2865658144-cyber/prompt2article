# 复制这个文件为 .env，填入自己的 Key，然后就能直接运行。
# .env 已在 .gitignore 中，不会被提交。

# 必填：API Key
P2A_API_KEY=sk-在这里填你的key

# 以下都是可选的，不写就用默认值。

# 接口地址。任何 OpenAI 兼容服务都可以：
#   DeepSeek  https://api.deepseek.com/v1
#   OpenAI    https://api.openai.com/v1
#   本地 Ollama http://127.0.0.1:11434/v1
P2A_BASE_URL=https://api.deepseek.com/v1

# 模型名
P2A_MODEL=deepseek-chat

# 单次请求超时（秒）
P2A_TIMEOUT=120

# 失败重试次数（针对限流、超时、5xx）
P2A_MAX_RETRIES=3

# 采样温度：写文章 0.6~0.8 比较合适，太低会干巴
P2A_TEMPERATURE=0.7
